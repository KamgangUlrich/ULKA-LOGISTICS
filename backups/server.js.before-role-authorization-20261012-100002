/* ===== STAFF LOGIN API ===== */

app.post("/api/staff/login", loginLimiter, async (req, res) => {
    try {
        const email = String(req.body.email || "").trim().toLowerCase();
        const password = String(req.body.password || "");

        if (!email || !password) {
            return res.status(400).json({
                success: false,
                error: "Please enter your email and password."
            });
        }

        const staff = db.prepare(`
            SELECT id, name, email, passwordHash, role, status
            FROM staff
            WHERE email = ?
        `).get(email);

        if (!staff) {
            return res.status(401).json({
                success: false,
                error: "Invalid email or password."
            });
        }

        const matches = await bcrypt.compare(password, staff.passwordHash);

        if (!matches) {
            return res.status(401).json({
                success: false,
                error: "Invalid email or password."
            });
        }

        if (staff.status !== "Active") {
            return res.status(403).json({
                success: false,
                error: "This account is inactive. Contact an administrator."
            });
        }

        req.session.regenerate((error) => {
            if (error) {
                console.error("Staff session error:", error.message);
                return res.status(500).json({
                    success: false,
                    error: "Unable to create a secure login session."
                });
            }

            req.session.staffId = staff.id;

            req.session.save((saveError) => {
                if (saveError) {
                    console.error("Staff session save error:", saveError.message);
                    return res.status(500).json({
                        success: false,
                        error: "Unable to save your login session."
                    });
                }

                return res.json({
                    success: true,
                    message: "Login successful.",
                    user: {
                        id: staff.id,
                        name: staff.name,
                        email: staff.email,
                        role: staff.role,
                        status: staff.status,
                        authType: "staff"
                    }
                });
            });
        });
    } catch (error) {
        console.error("Staff login error:", error.message);
        return res.status(500).json({
            success: false,
            error: "Unable to log in."
        });
    }
});


/* ===== VERIFY STAFF SESSION ===== */

app.get("/api/staff/me", (req, res) => {
    if (!req.session || !req.session.staffId) {
        return res.status(401).json({
            success: false,
            error: "Please log in to access this feature."
        });
    }

    const staff = db.prepare(`
        SELECT id, name, email, role, status
        FROM staff
        WHERE id = ?
    `).get(req.session.staffId);

    if (!staff || staff.status !== "Active") {
        return req.session.destroy(() => {
            res.clearCookie("ulka.sid", { path: "/" });
            return res.status(401).json({
                success: false,
                error: "Staff session is no longer active. Please log in again."
            });
        });
    }

    return res.json({
        success: true,
        user: {
            id: staff.id,
            name: staff.name,
            email: staff.email,
            role: staff.role,
            status: staff.status,
            authType: "staff"
        }
    });
});


